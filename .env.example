# =========================================================
# VEHICLEVISION AI - ENVIRONMENT VARIABLES CONFIGURATION
# =========================================================

# 1. Supabase Configuration (Get from Supabase Project Settings -> API)
# PUBLIC ANON KEY is safe to expose in frontend client code.
# NEVER expose the SERVICE_ROLE KEY in frontend code!
SUPABASE_URL=https://your-supabase-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key-here

# 2. FastAPI YOLOv5 Detection Backend Service URL
# Point this to your hosted FastAPI backend (e.g. Render / Railway / EC2 / Local)
DETECTION_BACKEND_URL=http://localhost:8000

# 3. CORS & Server Settings
ALLOWED_ORIGINS=http://localhost:3000,https://*.vercel.app,*
PORT=8000
